<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>ThesisAddIn.VSTO</RootNamespace>
    <AssemblyName>ThesisAddIn.VSTO</AssemblyName>
    <ProjectTypeGuids>{BAA0C2D2-18E2-41B9-852F-F413020CAA33};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <OfficeApplication>Word</OfficeApplication>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- These references are supplied by the Office/SharePoint workload on the
         Windows build machine. The project is intentionally not in the
         cross-platform Core/CLI solution. -->
    <Reference Include="Microsoft.Office.Tools.Common" />
    <Reference Include="Microsoft.Office.Tools.Word" />
    <Reference Include="Microsoft.Office.Interop.Word" />
    <Reference Include="Office" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Windows.Forms" />
    <ProjectReference Include="Protocol\ThesisAddIn.Protocol.csproj" />
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\OfficeTools\Microsoft.VisualStudio.Tools.Applications.targets"
          Condition="Exists('$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\OfficeTools\Microsoft.VisualStudio.Tools.Applications.targets')" />
</Project>
